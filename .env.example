# ============================================================
#  AgentDesk — environment variables
#  Copy karein:  cp .env.example .env
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent123
POSTGRES_DB=agentdesk

# Docker wale setup ke liye 5432 rakhein.
# Bina Docker (npm run db:dev) ke liye 55432 — taake kisi maujooda
# Postgres install se takra na jaye.
POSTGRES_PORT=55432

# ---------- Backend ----------
PORT=3100
NODE_ENV=development

# Docker ke andar host "db" hota hai. Bina Docker ke "localhost".
DB_HOST=localhost
DB_PORT=55432
DB_USER=agent
DB_PASSWORD=agent123
DB_NAME=agentdesk

# Dev mein TypeORM khud tables banata hai. Production mein FALSE + migrations.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ---------- LLM ----------
# provider = anthropic  ya  mock
#   mock      -> bina API key ke poora agentic flow chalta hai
#   anthropic -> asli Claude model
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=16000

# Agent ek turn mein max kitne steps chalega (infinite loop se bachne ke liye)
AGENT_MAX_STEPS=8

# ---------- Ports ----------
BACKEND_PORT=3100
FRONTEND_PORT=4300
CORS_ORIGIN=http://localhost:4300
