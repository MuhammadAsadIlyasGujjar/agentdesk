    "signals",
    "copilot",
    "generative-ui",
    "human-in-the-loop"
  ],
  "peerDependencies": {
    "@angular/common": ">=18.0.0",
    "@angular/core": ">=18.0.0",
    "@angular/forms": ">=18.0.0",
